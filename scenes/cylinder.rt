# Камера: смотрит спереди
C 0,-1,15 0,0,-1 60
A 0.2 255,255,255
L 10,10,10 0.6 2556,255,255

# Цилиндр (зеленый), немного наклонен в сторону
cy 0,0,0 0,1,0 1 4 0,255,0

# Сфера (красная), пересекает бок цилиндра
sp 0.5,1,0 1.5 255,0,0

# Плоскость (серая), как "пол"
pl 0,-0.01,0 0,1,0 100,100,100

# Другой цилиндр (синий), пересекает верх первого
cy 0,3,0 1,0,0 0.5 3 0,0,255
