
A 0.5 255,0,0        # Амбиент: 50% яркости, красный
C 0,0,-10 0,0,1 60   # Камера: перед сферой, угол обзора 60°
L 5,5,-5 1.0 255,255,255 # Белый точечный свет справа сверху
sp 0,0,0 4 200,200,200 0.4 100  # Большая серая сфера в центре
pl 0,-4,0 0,1,0 0,255,0 0.4 100 # Зелёная плоскость под сферой